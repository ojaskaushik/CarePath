
{
  "name": "carepath",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n BACKEND,FRONTEND -c green,blue \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "backend/.venv/bin/python -m uvicorn app.main:app --reload --app-dir backend"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
